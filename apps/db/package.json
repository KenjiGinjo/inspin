{
  "name": "db",
  "version": "0.0.1",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "db": "bun src/db-script.ts",
    "db:migrate": "bun src/db-script.ts migrate",
    "db:rollback": "bun src/db-script.ts rollback",
    "db:generate": "bun src/db-script.ts g",
    "db:seed": "bun seed/index.ts",
    "db:rebuild": "bun src/db-script.ts drop && bun src/db-script.ts create && bun src/db-script.ts migrate && bun seed/index.ts",
    "db:test": "bun test --env-file=.env.db.test --preload ./test/_setup.ts",
    "db:test-rebuild": "bun --env-file=.env.db.test src/db-script.ts drop && bun --env-file=.env.db.test src/db-script.ts create && bun --env-file=.env.db.test src/db-script.ts migrate"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "@inspin/constants": "workspace:*",
    "@inspin/enums": "workspace:*",
    "@inspin/interfaces": "workspace:*",
    "@inspin/tools": "workspace:*",
    "@inspin/validations": "workspace:*",
    "@paralleldrive/cuid2": "2.2.2",
    "bentocache": "1.4.0",
    "date-fns": "3.6.0",
    "orchid-orm": "^1.51.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "chalk": "5.3.0"
  }
}
